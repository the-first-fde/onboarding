{
  "env": {
    "ECC_DISABLED_HOOKS": "pre:write:doc-file-warning,pre:edit-write:suggest-compact,pre:bash:tmux-reminder,pre:bash:git-push-reminder,stop:evaluate-session,stop:desktop-notify"
  },
  "permissions": {
    "allow": [
      "Bash(codex exec:*)",
      "Bash(uv run pytest:*)",
      "Bash(npm run build:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Read(./**/.env.local)",
      "Edit(./**/.env.local)",
      "Read(./**/secrets/**)",
      "Edit(./**/secrets/**)",
      "Read(./**/credentials/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/token.json)",
      "Read(./**/credentials.json)",
      "Read(./knowledge/raw/**)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
