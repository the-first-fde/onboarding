# 명세만 공유한다. 실제 .env 생성/읽기는 이번 초기화에 포함하지 않는다.
# Mock 검증은 모든 키 없이 실행한다. 실제 값은 Git/로그/Issue/AI 입력에 넣지 않는다.
ONBOARDING_MODE=mock
# ANTHROPIC_API_KEY: 실제 호출 승인 후 개인 보안 저장소에서만 설정; 예시값 없음
# ANTHROPIC_MODEL: 모델과 비용 정책 합의 후 지정
# MCP 인증 변수: 연결 대상/최소 권한 합의 후 별도 ADR로 명세
# SONAR_TOKEN: GitHub Actions Secret에서만 관리
# SONAR_ORGANIZATION, SONAR_PROJECT_KEY: GitHub Actions Variables
# SONAR_ENABLED, EXTERNAL_ANALYSIS_APPROVED: 명시 승인 후 true; 기본 미설정/비활성
